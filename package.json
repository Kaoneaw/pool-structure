{
  "name": "pool-structure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/copy-assets.mjs",
    "dev": "npm run prepare:assets && vite --host 0.0.0.0",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "package:static": "npm run build && python3 scripts/package-static.py",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "pdfjs-dist": "6.4.299",
    "three": "0.186.1",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  },
  "engines": { "node": ">=22.13.0" }
}
